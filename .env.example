# Copy to .env (git-ignored). Local dev uses your own Google login (gcloud auth application-default login).
# Google AI via Vertex AI, billed to the Cloud project:
GOOGLE_GENAI_USE_VERTEXAI=true
# The real Google Cloud project for Vertex AI, BigQuery and Text-to-Speech
# (npm run dev points GOOGLE_CLOUD_PROJECT at the Firestore emulator, so this one is separate):
GCP_PROJECT=your-project-id
# Optional: send sensor minutes to BigQuery from local dev too (off by default)
# BQ_DATASET=drmacx
